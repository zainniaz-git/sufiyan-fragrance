    /* =====================================================
       CART COUNT
       ===================================================== */

    function updateCartButtons() {

        const count =
            getCartCount();

        const cartCounters =
            document.querySelectorAll(
                ".cart-count, [data-cart-count]"
            );

        cartCounters.forEach(counter => {

            counter.textContent = count;

            counter.style.display =
                count > 0 ? "flex" : "none";

        });
    }


    /* =====================================================
       CART EVENTS
       ===================================================== */

    document.addEventListener("click", e => {

        const addButton =
            e.target.closest("[data-add-cart]");

        if (addButton) {

            addToCart(
                addButton.dataset.addCart
            );

            return;
        }


        const plus =
            e.target.closest("[data-plus]");

        if (plus) {

            changeQuantity(
                plus.dataset.plus,
                1
            );

            return;
        }


        const minus =
            e.target.closest("[data-minus]");

        if (minus) {

            changeQuantity(
                minus.dataset.minus,
                -1
            );

            return;
        }


        const remove =
            e.target.closest("[data-remove-cart]");

        if (remove) {

            removeFromCart(
                remove.dataset.removeCart
            );

            return;
        }

    });


