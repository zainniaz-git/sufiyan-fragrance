    /* =====================================================
       CHECKOUT VALIDATION
       ===================================================== */

    function validateCheckout() {

        if (!checkoutForm) return false;


        const name =
            document.getElementById("custName");

        const phone =
            document.getElementById("custPhone");

        const email =
            document.getElementById("custEmail");

        const address =
            document.getElementById("custAddress");

        const city =
            document.getElementById("custCity");


        if (!name || !phone || !address || !city) {
            return false;
        }


        const errors = [];


        if (name.value.trim().length < 3) {

            errors.push(
                "Please enter your full name."
            );

        }


        if (
            phone.value
                .replace(/\D/g, "")
                .length < 10
        ) {

            errors.push(
                "Please enter a valid phone number."
            );

        }


        if (email && email.value.trim() !== "") {

            const emailRegex =
                /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

            if (!emailRegex.test(email.value.trim())) {

                errors.push(
                    "Please enter a valid email."
                );

            }

        }


        if (address.value.trim().length < 5) {

            errors.push(
                "Please enter your complete address."
            );

        }


        if (city.value.trim().length < 2) {

            errors.push(
                "Please enter your city."
            );

        }


        if (errors.length > 0) {

            if (checkoutFormError) {

                checkoutFormError.textContent =
                    errors[0];

                checkoutFormError.style.display =
                    "block";

            }

            return false;
        }


        if (checkoutFormError) {

            checkoutFormError.textContent = "";

            checkoutFormError.style.display =
                "none";
        }


        return true;
    }


